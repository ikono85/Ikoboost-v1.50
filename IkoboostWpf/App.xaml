<Application x:Class="IkoboostWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IkoboostWpf.Converters"
             StartupUri="Views/MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
        <ResourceDictionary Source="Themes/Strings.fr.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters -->
      <conv:BoolToVisibilityConverter   x:Key="BoolToVisConverter"/>
      <conv:InverseBoolConverter        x:Key="InvertBool"/>
      <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
      <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisConverter"/>
      <conv:BoolToOkErrConverter        x:Key="BoolToOkErrConverter"/>
      <conv:AppIconConverter            x:Key="AppIconConverter"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
