<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ════════════════════════════════════════════════════════════
       Ikoboost OS — thème sombre redesigné (Direction A · Control Center)
       Drop-in : toutes les clés existantes sont conservées.
       Nouvelles clés ajoutées : VioletBrush, BlueBrush (data-viz).
       ════════════════════════════════════════════════════════════ -->

  <!-- ── Couleurs ── -->
  <Color x:Key="BackgroundColor">#080B10</Color>
  <Color x:Key="SurfaceColor">#10151C</Color>
  <Color x:Key="SurfaceAltColor">#151B24</Color>
  <Color x:Key="SurfaceHoverColor">#1B2430</Color>
  <Color x:Key="BorderColor">#222B36</Color>
  <Color x:Key="BorderStrongColor">#344151</Color>
  <Color x:Key="AccentColor">#34DCEB</Color>
  <Color x:Key="AccentDimColor">#123F48</Color>
  <Color x:Key="TextPrimaryColor">#F2F6FA</Color>
  <Color x:Key="TextSecondaryColor">#A8B5C3</Color>
  <Color x:Key="TextTertiaryColor">#687586</Color>
  <Color x:Key="SuccessColor">#47D99B</Color>
  <Color x:Key="WarningColor">#F4B84A</Color>
  <Color x:Key="ErrorColor">#FF626A</Color>
  <Color x:Key="VioletColor">#A78BFA</Color>
  <Color x:Key="BlueColor">#5B8DEF</Color>

  <!-- ── Brushes (clés inchangées pour compatibilité) ── -->
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
  <SolidColorBrush x:Key="ErrorDimBrush" Color="#3B171B"/>
  <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
  <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="DataGridAltBrush" Color="#08FFFFFF"/>

  <!-- ── Dégradé carte métrique (surfaces empilées) ── -->
  <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#111821" Offset="0"/>
    <GradientStop Color="#0E131B" Offset="1"/>
  </LinearGradientBrush>

  <!-- ── Dégradé signature (boutons primaires, jauges) ── -->
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#45E6F1" Offset="0"/>
    <GradientStop Color="#21BFD0" Offset="1"/>
  </LinearGradientBrush>

  <!-- ── Rayons / typo (référence) ──
       CardRadius : 14   ·   ControlRadius : 7
       Police UI : "Hanken Grotesk"   ·   Chiffres : "JetBrains Mono" -->
  <CornerRadius x:Key="CardRadius">10</CornerRadius>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>

</ResourceDictionary>
