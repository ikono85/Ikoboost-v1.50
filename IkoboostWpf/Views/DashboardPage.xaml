<Page x:Class="IkoboostWpf.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:IkoboostWpf.Controls"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Dashboard.Title}">

  <!-- ════════════════════════════════════════════════════════════════
       Dashboard redesigné — Direction A « Control Center » (Ikoboost OS)
       • Bindings 100 % identiques à ton ViewModel (rien à changer côté C#).
       • Nécessite 2 contrôles fournis : GaugeRingControl + ThermalBarControl
         (dans IkoboostWpf/Controls/). Réutilise SparklineControl & HealthRingControl.
       ════════════════════════════════════════════════════════════════ -->

  <Page.Resources>
    <Style x:Key="ModernCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="MetricName" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="CardHead" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelStyle}">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="MonoLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabelStyle}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,22,24,28">

      <!-- ── En-tête ─────────────────────────────────────────────── -->
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource Dashboard.Title}" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock FontSize="11.5" FontFamily="Consolas"
                     Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0">
            <Run Text="{Binding MachineName}"/><Run Text=" · "/><Run Text="{Binding UserName}"/><Run Text=" · "/><Run Text="{Binding OsVersion}"/>
          </TextBlock>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="14,10" VerticalAlignment="Center">
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Dashboard.Uptime}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            <TextBlock Text="{Binding Uptime}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="12" Margin="4,0,0,0"/>
          </WrapPanel>
        </Border>
      </Grid>

      <TextBlock Text="{DynamicResource Dashboard.Loading}"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

      <!-- ── Grille de métriques (anneau + icône, comme la maquette) ── -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CPU -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,7,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="52" Height="52" VerticalAlignment="Center">
                <controls:GaugeRingControl Percent="{Binding CpuPercent}" Maximum="100" Thickness="6" RingBrush="{DynamicResource AccentBrush}"/>
                <Viewbox Width="20" Height="20">
                  <Path Data="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3M5 5h14v14H5zM9 9h6v6H9z"
                        Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Viewbox>
              </Grid>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="CPU" Style="{StaticResource MetricName}"/>
                  <Border Grid.Column="1"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="{DynamicResource ControlRadius}"
                          Padding="8,3"
                          Margin="8,0,0,0"
                          ToolTip="{Binding CpuTempDiagnostic}">
                    <TextBlock Text="{Binding CpuTempText}"
                               Foreground="{Binding CpuTempBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold"/>
                  </Border>
                </Grid>
                <TextBlock Style="{StaticResource BigNumber}">
                  <Run Text="{Binding CpuPercent, StringFormat='{}{0:F0}'}"/><Run Text=" %" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>
              </StackPanel>
            </Grid>
            <controls:SparklineControl Values="{Binding CpuHistory}" LineBrush="{DynamicResource AccentBrush}"
                                       MaxValue="100" Height="40" Margin="0,12,0,0" ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MonoLabel}" Margin="0,10,0,0">
              <Run Text="{Binding CpuCurrentClockMhz}"/><Run Text=" MHz · "/><Run Text="{Binding CpuTemperature}"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- RAM -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="3.5,0,3.5,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="52" Height="52" VerticalAlignment="Center">
                <controls:GaugeRingControl Percent="{Binding RamPercent}" Maximum="100" Thickness="6" RingBrush="{DynamicResource VioletBrush}"/>
                <Viewbox Width="20" Height="20">
                  <Path Data="M3 7h18v7H3zM6 14v3M10 14v3M14 14v3M18 14v3M6 10h2M11 10h2M16 10h2"
                        Stroke="{DynamicResource VioletBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Viewbox>
              </Grid>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MÉMOIRE" Style="{StaticResource MetricName}"/>
                <TextBlock Style="{StaticResource BigNumber}">
                  <Run Text="{Binding RamPercent, StringFormat='{}{0:F0}'}"/><Run Text=" %" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </TextBlock>
              </StackPanel>
            </Grid>
            <controls:SparklineControl Values="{Binding RamHistory}" LineBrush="{DynamicResource VioletBrush}"
                                       MaxValue="100" Height="40" Margin="0,12,0,0" ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MonoLabel}" Margin="0,10,0,0">
              <Run Text="{Binding RamUsedMb, StringFormat='{}{0:N0}'}"/><Run Text=" / "/><Run Text="{Binding RamTotalMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- GPU -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="3.5,0,3.5,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="52" Height="52" VerticalAlignment="Center">
                <controls:GaugeRingControl Percent="{Binding GpuPercent}" Maximum="100" Thickness="6" RingBrush="{DynamicResource BlueBrush}"/>
                <Viewbox Width="20" Height="20">
                  <Path Data="M2 6h20v10H2zM6 16v3M16 16v3M13 9a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"
                        Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                </Viewbox>
              </Grid>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="GPU" Style="{StaticResource MetricName}"/>
                <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource BigNumber}"/>
              </StackPanel>
            </Grid>
            <controls:SparklineControl Values="{Binding GpuHistory}" LineBrush="{DynamicResource BlueBrush}"
                                       MaxValue="100" Height="40" Margin="0,12,0,0" ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MonoLabel}" Margin="0,10,0,0" TextWrapping="Wrap">
              <Run Text="{Binding GpuTemperature}"/><Run Text=" · "/><Run Text="{Binding GpuMemory}"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Réseau -->
        <Border Grid.Column="3" Style="{StaticResource ModernCard}" Margin="7,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="52" Height="52" VerticalAlignment="Center">
                <controls:GaugeRingControl Percent="{Binding NetworkInMbps}" Maximum="100" Thickness="6" RingBrush="{DynamicResource SuccessBrush}"/>
                <Viewbox Width="20" Height="20">
                  <Path Data="M2 13a10 10 0 0 1 20 0M5.5 16.5a6 6 0 0 1 13 0M9 19.5a2.5 2.5 0 0 1 6 0"
                        Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
              </Grid>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Dashboard.Network}" Style="{StaticResource MetricName}"/>
                <TextBlock Style="{StaticResource BigNumber}">
                  <Run Text="{Binding NetworkInMbps, StringFormat='{}{0:F1}'}"/><Run Text=" ↓" FontSize="14" Foreground="{DynamicResource SuccessBrush}"/>
                </TextBlock>
              </StackPanel>
            </Grid>
            <controls:SparklineControl Values="{Binding NetworkInHistory}" LineBrush="{DynamicResource SuccessBrush}"
                                       Height="40" Margin="0,12,0,0" ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MonoLabel}" Margin="0,10,0,0">
              <Run Text="↑ "/><Run Text="{Binding NetworkOutMbps, StringFormat='{}{0:F1}'}"/><Run Text=" Mbps · "/><Run Text="{Binding PingMs}"/><Run Text=" ms"/>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Score de santé + Températures ────────────────────────── -->
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Score santé système -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,7,0">
          <StackPanel>
            <TextBlock Text="SCORE DE SANTÉ SYSTÈME" Style="{StaticResource CardHead}"/>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,24,0">
                <controls:HealthRingControl Score="{Binding HealthScore}" RingBrush="{Binding HealthScoreBrush}" Width="120" Height="120"/>
                <TextBlock Text="{Binding HealthLabel}" Foreground="{Binding HealthScoreBrush}"
                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                  <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthCpuScore}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Height="6" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding HealthCpuScore}"/></TextBlock>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Mémoire" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthRamScore}" Maximum="100" Foreground="{DynamicResource VioletBrush}" Height="6" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding HealthRamScore}"/></TextBlock>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Température" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthTempScore}" Maximum="100" Foreground="{DynamicResource WarningBrush}" Height="6" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding HealthTempScore}"/></TextBlock>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Disque" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthDiskScore}" Maximum="100" Foreground="{DynamicResource SuccessBrush}" Height="6" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"><Run Text="{Binding HealthDiskScore}"/></TextBlock>
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Températures (avec barres thermiques) -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="7,0,0,0">
          <StackPanel>
            <TextBlock Text="TEMPÉRATURES" Style="{StaticResource CardHead}"/>

            <!-- Processeur -->
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Processeur" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
              <TextBlock Grid.Column="1" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
            </Grid>
            <controls:ThermalBarControl TempText="{Binding CpuTempText}" Height="8" Margin="0,7,0,0"/>

            <!-- Carte graphique -->
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Carte graphique" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
              <TextBlock Grid.Column="1" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
            </Grid>
            <controls:ThermalBarControl TempText="{Binding GpuTempText}" Height="8" Margin="0,7,0,0"/>

            <!-- Carte mère (affichée même sans capteur — N/A si non détecté) -->
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Carte mère" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"/>
              <TextBlock Grid.Column="1" Text="{Binding MoboTempText}" Foreground="{Binding MoboTempBrush}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
            </Grid>
            <controls:ThermalBarControl TempText="{Binding MoboTempText}" Height="8" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Stockage ─────────────────────────────────────────────── -->
      <Border Style="{StaticResource ModernCard}">
        <StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Dashboard.Storage}" Style="{StaticResource CardHead}" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{Binding DriveInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Drives}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Label, StringFormat='  {0}'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold">
                    <Run Text="{Binding UsagePercent, StringFormat='{}{0:F0}'}"/><Run Text=" %"/>
                  </TextBlock>
                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding UsagePercent}" Maximum="100" Height="6" Foreground="{Binding UsageBrush}" Margin="0,7,0,0"/>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource MonoLabel}" Margin="0,5,0,0">
                    <Run Text="{DynamicResource Dashboard.Used}"/><Run Text="{Binding Used}"/>
                    <Run Text=" · "/><Run Text="{DynamicResource Dashboard.Available}"/><Run Text="{Binding Available}"/>
                    <Run Text=" · "/><Run Text="{DynamicResource Dashboard.Total}"/><Run Text="{Binding Total}"/>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
