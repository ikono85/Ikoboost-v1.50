<Page x:Class="IkoboostWpf.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:IkoboostWpf.Controls"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Dashboard.Title}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <!-- Header -->
<TextBlock Text="{DynamicResource Dashboard.Title}" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
      <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20">
        <Run Text="{Binding MachineName}"/> — <Run Text="{Binding UserName}"/> — <Run Text="{Binding OsVersion}"/>
      </TextBlock>

      <!-- Loading -->
      <TextBlock Text="{DynamicResource Dashboard.Loading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

      <!-- Uptime banner -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
        <WrapPanel>
          <TextBlock Text="{DynamicResource Dashboard.Uptime}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding Uptime}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource Dashboard.CpuLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"/>
          <TextBlock Text="{Binding CpuName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{DynamicResource Dashboard.GpuLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"/>
          <TextBlock Text="{Binding GpuName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{DynamicResource Dashboard.RamLabel}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"/>
          <TextBlock Text="{Binding RamReference}" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{DynamicResource Dashboard.Motherboard}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,0,0,0"/>
          <TextBlock Text="{Binding MotherboardReference}" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </WrapPanel>
      </Border>

      <!-- Metric grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CPU -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,8">
          <StackPanel>
            <TextBlock Text="CPU" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding CpuPercent, StringFormat='{}{0:F1}'}"/><Run Text=" %"/>
            </TextBlock>
            <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
            <controls:SparklineControl Values="{Binding CpuHistory}"
                                       LineBrush="{DynamicResource AccentBrush}"
                                       MaxValue="100"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       ClipToBounds="True"/>
            <TextBlock Text="{Binding CpuDetails}" Style="{StaticResource MetricLabelStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.Frequency}"/><Run Text="{Binding CpuCurrentClockMhz}"/><Run Text=" MHz"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.MaxClock}"/><Run Text="{Binding CpuMaxClockMhz}"/><Run Text=" MHz"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0" TextWrapping="Wrap">
              <Run Text="{DynamicResource Dashboard.TempCpu}"/><Run Text="{Binding CpuTemperature}"/>
            </TextBlock>
            <TextBlock Text="{Binding CpuName}" Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- RAM -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,8">
          <StackPanel>
            <TextBlock Text="RAM" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding RamPercent, StringFormat='{}{0:F1}'}"/><Run Text="%"/>
            </TextBlock>
            <ProgressBar Value="{Binding RamPercent}" Maximum="100" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
            <controls:SparklineControl Values="{Binding RamHistory}"
                                       LineBrush="{Binding RamSparklineBrush}"
                                       MaxValue="100"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.Available}"/><Run Text="{Binding RamAvailableMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.Used}"/><Run Text="{Binding RamUsedMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.Total}"/><Run Text="{Binding RamTotalMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- GPU -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,4,8">
          <StackPanel>
            <TextBlock Text="GPU" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Text="{Binding GpuUsageText}" Style="{StaticResource MetricValueStyle}"/>
            <ProgressBar Value="{Binding GpuPercent}" Maximum="100" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
            <controls:SparklineControl Values="{Binding GpuHistory}"
                                       LineBrush="{DynamicResource WarningBrush}"
                                       MaxValue="100"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,6,0,0" TextWrapping="Wrap">
              <Run Text="{DynamicResource Dashboard.Temperature}"/><Run Text="{Binding GpuTemperature}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.VramLabel}"/><Run Text="{Binding GpuMemory}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0" TextWrapping="Wrap">
              <Run Text="{DynamicResource Dashboard.Driver}"/><Run Text="{Binding GpuDriver}"/>
            </TextBlock>
            <TextBlock Text="{Binding GpuName}" Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Network -->
        <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,8">
          <StackPanel>
            <TextBlock Text="{DynamicResource Dashboard.Network}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding NetworkInMbps, StringFormat='{}{0:F2}'}"/><Run Text=" ↓"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}">
              <Run Text="{Binding NetworkOutMbps, StringFormat='{}{0:F2}'}"/><Run Text=" Mbps ↑"/>
            </TextBlock>
            <controls:SparklineControl Values="{Binding NetworkInHistory}"
                                       LineBrush="{DynamicResource AccentDimBrush}"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       ClipToBounds="True"/>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,4,0,0">
              <Run Text="{DynamicResource Dashboard.PingLabel}"/><Run Text="{Binding PingMs}"/><Run Text=" ms"/>
            </TextBlock>
            <TextBlock Text="{Binding NetworkAdapterName}" Style="{StaticResource MetricLabelStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.IpLabel}"/><Run Text="{Binding NetworkAddress}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0">
              <Run Text="{DynamicResource Dashboard.Link}"/><Run Text="{Binding NetworkSpeed}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MetricLabelStyle}" Margin="0,2,0,0" TextWrapping="Wrap">
              <Run Text="{DynamicResource Dashboard.DnsLabel}"/><Run Text="{Binding NetworkDns}"/>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Score santé + Températures ──────────────────────────────── -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Score santé système -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="🏥 Score santé système" Style="{StaticResource SectionLabelStyle}"/>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Anneau + label -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,20,0">
                <controls:HealthRingControl Score="{Binding HealthScore}"
                                            RingBrush="{Binding HealthScoreBrush}"
                                            Width="96" Height="96"/>
                <TextBlock Text="/100"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding HealthLabel}"
                           Foreground="{Binding HealthScoreBrush}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>

              <!-- Détail par métrique -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center">

                <!-- CPU -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthCpuScore}" Maximum="100"
                               Foreground="{DynamicResource AccentBrush}" Height="4" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding HealthCpuScore}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>

                <!-- RAM -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="RAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthRamScore}" Maximum="100"
                               Foreground="{DynamicResource SuccessBrush}" Height="4" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding HealthRamScore}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>

                <!-- Temp -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Temp" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthTempScore}" Maximum="100"
                               Foreground="{DynamicResource WarningBrush}" Height="4" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding HealthTempScore}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>

                <!-- Disque -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Disk" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding HealthDiskScore}" Maximum="100"
                               Foreground="{DynamicResource AccentDimBrush}" Height="4" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Run Text="{Binding HealthDiskScore}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>

              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Températures -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="🌡 Températures" Style="{StaticResource SectionLabelStyle}"/>

            <!-- CPU -->
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding CpuTempText}"
                         Foreground="{Binding CpuTempBrush}"
                         FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>

            <!-- GPU (masqué si pas de capteur) -->
            <Grid Margin="0,12,0,0"
                  Visibility="{Binding HasGpuTempSensor, Converter={StaticResource BoolToVisConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="GPU" Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding GpuTempText}"
                         Foreground="{Binding GpuTempBrush}"
                         FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>

            <!-- Carte mère (masqué si pas de capteur) -->
            <Grid Margin="0,12,0,0"
                  Visibility="{Binding HasMoboTempSensor, Converter={StaticResource BoolToVisConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Carte mère" Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding MoboTempText}"
                         Foreground="{Binding MoboTempBrush}"
                         FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>

          </StackPanel>
        </Border>

      </Grid>

      <!-- Drives -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
        <StackPanel>
          <TextBlock Text="{DynamicResource Dashboard.Storage}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{Binding DriveInfo}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
          <ItemsControl ItemsSource="{Binding Drives}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,8,0,2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Label, StringFormat='  {0}'}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>

                  <TextBlock Grid.Row="0" Grid.Column="1"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold">
                    <Run Text="{Binding UsagePercent, StringFormat='{}{0:F1}'}"/><Run Text=" %"/>
                  </TextBlock>

                  <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                               Value="{Binding UsagePercent}"
                               Maximum="100"
                               Foreground="{Binding UsageBrush}"
                               Margin="0,6,0,0"/>

                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                             Style="{StaticResource MetricLabelStyle}"
                             Margin="0,4,0,0">
                    <Run Text="{DynamicResource Dashboard.Used}"/><Run Text="{Binding Used}"/>
                    <Run Text="{DynamicResource Dashboard.Available}"/><Run Text="{Binding Available}"/>
                    <Run Text="{DynamicResource Dashboard.Total}"/><Run Text="{Binding Total}"/>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
