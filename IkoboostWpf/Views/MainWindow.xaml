<Window x:Class="IkoboostWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IkoboostWpf.Views"
        xmlns:controls="clr-namespace:IkoboostWpf.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ikoboost" Height="820" Width="1280"
        MinHeight="680" MinWidth="1040"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- ════════════════════════════════════════════════════════════════
       Shell redesigné — sidebar groupée (Monitor / Manage / Système).
       Tous les hooks code-behind sont préservés :
       x:Name (Btn*, ContentFrame, VideoBackground, VideoOverlay),
       Click=NavButton_Click, Tag, et les handlers MediaElement.
       ════════════════════════════════════════════════════════════════ -->

  <Window.Resources>
    <Style x:Key="NavGroupLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="18,16,0,6"/>
    </Style>
    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#041418"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <MediaElement x:Name="VideoBackground"
                  Grid.ColumnSpan="2"
                  LoadedBehavior="Manual"
                  UnloadedBehavior="Manual"
                  Stretch="UniformToFill"
                  IsMuted="True"
                  Volume="0"
                  Opacity="0"
                  MediaOpened="VideoBackground_MediaOpened"
                  MediaEnded="VideoBackground_MediaEnded"
                  MediaFailed="VideoBackground_MediaFailed"/>
    <Border x:Name="VideoOverlay"
            Grid.ColumnSpan="2"
            Background="#99000000"
            Opacity="0"
            IsHitTestVisible="False"/>

    <!-- ── Sidebar ── -->
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- Logo -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,16,18">
          <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2FE6F2" Offset="0"/>
                <GradientStop Color="#0E7C8A" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Viewbox Width="17" Height="17">
              <Path Data="M13 2L4 14h6l-1 8 9-12h-6z" Fill="#04222A"/>
            </Viewbox>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="IKOBOOST" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold"/>
            <TextBlock Text="System Control Center" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="v1.5 · .NET 8"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   FontFamily="Consolas" FontSize="10" Margin="18,0,0,14"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
          <Border Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CardRadius}"
                  Padding="10"
                  Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <controls:HealthRingControl x:Name="SidebarHealthRing"
                                           Width="42" Height="42"
                                           Score="80"
                                           Compact="True"
                                           RingBrush="{DynamicResource SuccessBrush}"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Sante systeme"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"/>
                <TextBlock x:Name="SidebarHealthLabel"
                           Text="Optimal"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="10"
                           FontWeight="Bold"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="8,0">
          <TextBlock Text="MONITOR" Style="{StaticResource NavGroupLabel}" Margin="10,4,0,6"/>
          <Button x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Dashboard" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Dashboard}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnHardware" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Hardware" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Hardware}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnNetwork" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Network" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Network}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnProcesses" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Processes" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Processes}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>

          <TextBlock Text="MANAGE" Style="{StaticResource NavGroupLabel}"/>
          <Button x:Name="BtnWinget" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Winget" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Applications}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnStartup" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Startup" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Startup}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnOptimize" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Optimize" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Optimize}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>

          <TextBlock Text="SYSTÈME" Style="{StaticResource NavGroupLabel}"/>
          <Button x:Name="BtnSettings" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Settings" Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Nav.Settings}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{DynamicResource BackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
        <Grid Margin="22,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TopTitle"
                       Text="Dashboard"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock x:Name="TopSubtitle"
                       Text="Vue globale du systeme"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontFamily="Consolas"
                       FontSize="11"
                       Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlRadius}"
                    Padding="10,5"
                    Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7A5;" FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="CPU " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="TopCpuTemp" Text="N/A" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlRadius}"
                    Padding="10,5"
                    Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                           Foreground="{DynamicResource AccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="TopPing" Text="-- ms" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
              </StackPanel>
            </Border>

            <Button x:Name="TopOptimizeButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="TopOptimize_Click"
                    Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                <TextBlock Text="Optimisation 1-clic"/>
              </StackPanel>
            </Button>

            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlRadius}"
                    Padding="8,4"
                    Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Live" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold"/>
              </StackPanel>
            </Border>

            <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="Minimize_Click"/>
            <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click"/>
            <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Frame x:Name="ContentFrame"
             Grid.Row="1"
             NavigationUIVisibility="Hidden"
             Background="Transparent"/>
    </Grid>
  </Grid>
</Window>
