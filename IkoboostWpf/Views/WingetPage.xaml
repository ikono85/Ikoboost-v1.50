<Page x:Class="IkoboostWpf.Views.WingetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Nav.Applications}">

  <Page.Resources>
    <Style x:Key="AppCardButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
      <Setter Property="MinWidth" Value="86"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
  </Page.Resources>

  <DockPanel Margin="24">

    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel>
        <TextBlock Text="{DynamicResource Applications.Title}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="{Binding VisibleAppCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalAppCount, Mode=OneWay}"/><Run Text=" applications"/>
          </TextBlock>
          <Border Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8,2"
                  Margin="12,0,0,0">
            <TextBlock Text="{Binding WingetStatusText, Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="{DynamicResource Applications.RefreshList}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding LoadAppsCommand}"/>
        <Button Content="{DynamicResource Applications.UpgradeAll}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding UpgradeAllCommand}"
                Margin="8,0,0,0"/>
      </StackPanel>
    </Grid>

    <Border DockPanel.Dock="Top"
            Style="{StaticResource CardStyle}"
            Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="Rechercher une application"
                     Style="{StaticResource SectionLabelStyle}"/>
          <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Height="34"
                   FontSize="14"
                   Padding="10,6"/>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Bottom">
          <TextBlock Text="Action rapide"
                     Style="{StaticResource SectionLabelStyle}"/>
          <Button Content="{DynamicResource Applications.UninstallSelected}"
                  Style="{StaticResource DangerButtonStyle}"
                  Command="{Binding UninstallCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Style="{StaticResource CardStyle}"
            Margin="0,12,0,0"
            MaxHeight="110">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding StatusLog}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontFamily="Consolas"
                   FontSize="11"
                   TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>

    <ListBox ItemsSource="{Binding Apps}"
             SelectedItem="{Binding SelectedApp}"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>

      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,0,12,12"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
      </ListBox.ItemContainerStyle>

      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource CardStyle}"
                  Width="360"
                  MinHeight="170">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="52"
                        Height="52"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                  <Image Source="{Binding IconPath, Converter={StaticResource AppIconConverter}}"
                         Width="42"
                         Height="42"
                         Stretch="UniformToFill"
                         ClipToBounds="True"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontWeight="SemiBold"
                             FontSize="15"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding DisplayPublisher, Mode=OneWay}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource Applications.InstalledVersion}"
                             Style="{StaticResource SectionLabelStyle}"/>
                  <TextBlock Text="{Binding DisplayVersion, Mode=OneWay}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Text="{DynamicResource Common.Source}"
                             Style="{StaticResource SectionLabelStyle}"/>
                  <TextBlock Text="{Binding SourceLabel, Mode=OneWay}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Id}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>

                <Button Grid.Column="1"
                        Content="Mettre a jour"
                        Style="{StaticResource AppCardButtonStyle}"
                        Command="{Binding DataContext.UpgradeAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Content="Desinstaller"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        MinWidth="94"
                        Height="30"
                        Padding="10,4"/>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Page>
