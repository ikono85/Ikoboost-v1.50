<Page x:Class="IkoboostWpf.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Nav.Startup}">

  <Page.Resources>
    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SwitchBox" TargetType="CheckBox">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#1B2634">
              <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#8FA0B2" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Knob" Property="Fill" Value="#0A0D13"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StartupGrid" TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserSortColumns" Value="False"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="48"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="ColumnHeaderStyle">
        <Setter.Value>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="RowStyle">
        <Setter.Value>
          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,24">
      <StackPanel Margin="0,0,0,16">
        <TextBlock Text="Démarrage" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="Programmes lancés au démarrage de Windows"
                   FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
      </StackPanel>

      <UniformGrid Columns="3" Margin="0,0,0,14">
        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Activés" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
            <TextBlock Text="{Binding EnabledCount}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
            <TextBlock Text="lancés au démarrage" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Désactivés" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
            <TextBlock Text="{Binding DisabledCount}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
            <TextBlock Text="ignorés au démarrage" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Impact démarrage" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
            <TextBlock Text="{Binding StartupImpactText}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
            <TextBlock Text="estimation gain possible" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PROGRAMMES AU DÉMARRAGE" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox Width="250" Height="32" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrer..."/>
              <Button Content="Actualiser" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding LoadCommand}" Height="32" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>

          <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource StartupGrid}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="90">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="ACTIVÉ" Style="{StaticResource HeaderText}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource SwitchBox}"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanToggle}"
                              Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="230">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="NOM" Style="{StaticResource HeaderText}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="120">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="IMPACT" Style="{StaticResource HeaderText}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="7" Padding="8,3" HorizontalAlignment="Left" Background="{Binding ImpactBackground}" BorderBrush="{Binding ImpactBrush}" BorderThickness="1">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="4" Height="4" Fill="{Binding ImpactBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Impact}" Foreground="{Binding ImpactBrush}" FontSize="10.5" FontWeight="Bold"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="210">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="SOURCE" Style="{StaticResource HeaderText}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextSecondaryBrush}"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="*">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="COMMANDE" Style="{StaticResource HeaderText}"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><TextBlock Text="{Binding Command}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
