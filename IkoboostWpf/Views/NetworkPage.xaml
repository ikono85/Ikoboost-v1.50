<Page x:Class="IkoboostWpf.Views.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Network.Title}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
<TextBlock Text="{DynamicResource Network.Title}" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

      <!-- Adapter info -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{DynamicResource Network.Adapter}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Text="{Binding AdapterName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Ipv4}" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Ipv6}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{DynamicResource Network.Adapter}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
              <Run Text="{DynamicResource Network.GatewayLabel}"/><Run Text="{Binding Gateway}" Foreground="{DynamicResource AccentBrush}"/>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
              <Run Text="{DynamicResource Network.DnsLabel}"/><Run Text="{Binding Dns}"/>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
              <Run Text="{DynamicResource Network.PingServerLabel}"/><Run Text="{Binding PingMs}" Foreground="{DynamicResource AccentBrush}"/><Run Text=" ms"/>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>

      <!-- DNS -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Network.ChangeDns}" Style="{StaticResource SectionLabelStyle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ComboBox ItemsSource="{Binding DnsProfiles.Keys}"
                      SelectedItem="{Binding SelectedDnsProfile}"
                      Width="180"/>
            <Button Content="{DynamicResource Common.Apply}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetDnsCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                    Margin="8,0,0,0"/>
            <Button Content="{DynamicResource Network.FlushDns}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding FlushDnsCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                    Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding DnsLog}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="Consolas"
                     FontSize="12"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Throughput -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="↓ " Foreground="{DynamicResource SuccessBrush}" FontSize="18"/>
          <TextBlock FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="{Binding InMbps, StringFormat='{}{0:F2}'}"/>
            <Run Text=" Mbps"/>
          </TextBlock>
          <TextBlock Text="   ↑ " Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="24,0,0,0"/>
          <TextBlock FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}">
            <Run Text="{Binding OutMbps, StringFormat='{}{0:F2}'}"/>
            <Run Text=" Mbps"/>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Speed Test -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Speed Test" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="{Binding SpeedTestStatus}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource Network.RunTest}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunSpeedTestCommand}"
                    IsEnabled="{Binding IsSpeedTestRunning, Converter={StaticResource InvertBool}}"/>
          </Grid>

          <ProgressBar Value="{Binding SpeedTestProgress}"
                       Maximum="100"
                       IsIndeterminate="{Binding IsSpeedTestRunning}"
                       Foreground="{DynamicResource AccentDimBrush}"
                       Margin="0,0,0,12"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Ping" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding SpeedTestPingMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="Download" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding SpeedTestDownloadMbps, StringFormat='{}{0:F2}'}"/><Run Text=" Mbps"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="Upload" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding SpeedTestUploadMbps, StringFormat='{}{0:F2}'}"/><Run Text=" Mbps"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="Jitter" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding SpeedTestJitterMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Text="{Binding SpeedTestError}"
                     Visibility="{Binding SpeedTestError, Converter={StaticResource StringToVisConverter}}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

          <TextBlock Text="{DynamicResource Network.History}" Style="{StaticResource SectionLabelStyle}"/>
          <DataGrid ItemsSource="{Binding SpeedTestHistory}" IsReadOnly="True" MaxHeight="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Network.Time}" Binding="{Binding Time}" Width="90"/>
              <DataGridTextColumn Header="Ping (ms)" Binding="{Binding PingMs, StringFormat='{}{0:F1}'}" Width="110"/>
              <DataGridTextColumn Header="Download (Mbps)" Binding="{Binding DownloadMbps, StringFormat='{}{0:F2}'}" Width="150"/>
              <DataGridTextColumn Header="Upload (Mbps)" Binding="{Binding UploadMbps, StringFormat='{}{0:F2}'}" Width="140"/>
              <DataGridTextColumn Header="Jitter (ms)" Binding="{Binding JitterMs, StringFormat='{}{0:F1}'}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Ping toolbar -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="{DynamicResource Network.TestAllServers}" Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding PingAllCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
        <Button Content="{DynamicResource Network.Repair}" Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding RepairNetworkCommand}" Margin="8,0,0,0"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
      </StackPanel>

      <!-- Ping stats -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Network.AveragePing}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding PingAverageMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Network.Minimum}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding PingMinMs}"/><Run Text=" ms"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Network.Maximum}" Style="{StaticResource SectionLabelStyle}"/>
            <TextBlock Style="{StaticResource MetricValueStyle}">
              <Run Text="{Binding PingMaxMs}"/><Run Text=" ms"/>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Ping results -->
      <DataGrid ItemsSource="{Binding PingResults}" IsReadOnly="True" MaxHeight="200" Margin="0,0,0,12">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{DynamicResource Network.Server}" Binding="{Binding Host}" Width="*"/>
          <DataGridTemplateColumn Header="{DynamicResource Common.Status}" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Success, Converter={StaticResource BoolToOkErrConverter}}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Success}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Success}" Value="False">
                          <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{DynamicResource Network.Latency}" Binding="{Binding Ms}" Width="120"/>
          <DataGridTextColumn Header="{DynamicResource Common.Error}" Binding="{Binding Error}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Repair log -->
      <Border Style="{StaticResource CardStyle}" Visibility="{Binding RepairLog, Converter={StaticResource StringToVisConverter}}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Network.RepairLog}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{Binding RepairLog}" Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
