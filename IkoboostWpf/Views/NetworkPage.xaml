<Page x:Class="IkoboostWpf.Views.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:IkoboostWpf.Controls"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Network.Title}">

  <!-- Réseau redesigné — bindings/commandes/convertisseurs inchangés. -->

  <Page.Resources>
    <Style x:Key="ModernCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,22,24,28">
      <TextBlock Text="{DynamicResource Network.Title}" FontSize="22" FontWeight="Bold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

      <!-- Adaptateur + débit -->
      <Grid Margin="0,0,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,7,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{DynamicResource Network.Adapter}" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="{Binding AdapterName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Ipv4}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="18" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding Ipv6}" Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                <Run Text="{DynamicResource Network.GatewayLabel}"/><Run Text="{Binding Gateway}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas"/>
              </TextBlock>
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                <Run Text="{DynamicResource Network.DnsLabel}"/><Run Text="{Binding Dns}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas"/>
              </TextBlock>
              <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{DynamicResource Network.PingServerLabel}"/><Run Text="{Binding PingMs}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/><Run Text=" ms"/>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="7,0,0,14">
          <StackPanel>
            <TextBlock Text="DÉBIT EN TEMPS RÉEL" Style="{StaticResource SectionLabelStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <StackPanel>
                <TextBlock Text="↓ RÉCEPTION" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding InMbps, StringFormat='{}{0:F1}'}"/><Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
              </StackPanel>
              <StackPanel Margin="28,0,0,0">
                <TextBlock Text="↑ ENVOI" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding OutMbps, StringFormat='{}{0:F1}'}"/><Run Text=" Mbps" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></TextBlock>
              </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.7" Margin="0,18,0,10"/>
            <controls:SparklineControl Values="{Binding InHistory}"
                                       LineBrush="{DynamicResource SuccessBrush}"
                                       MaxValue="100"
                                       Height="48"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- DNS -->
      <Border Style="{StaticResource ModernCard}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Network.ChangeDns}" Style="{StaticResource SectionLabelStyle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <ComboBox ItemsSource="{Binding DnsProfiles.Keys}" SelectedItem="{Binding SelectedDnsProfile}" Width="200"/>
            <Button Content="{DynamicResource Common.Apply}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetDnsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" Margin="8,0,0,0"/>
            <Button Content="{DynamicResource Network.FlushDns}" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding FlushDnsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding DnsLog}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Speed Test -->
      <Border Style="{StaticResource ModernCard}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="SPEED TEST" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="{Binding SpeedTestStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource Network.RunTest}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunSpeedTestCommand}" IsEnabled="{Binding IsSpeedTestRunning, Converter={StaticResource InvertBool}}"/>
          </Grid>

          <ProgressBar Value="{Binding SpeedTestProgress}" Maximum="100" Height="6"
                       IsIndeterminate="{Binding IsSpeedTestRunning}"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="Ping" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"><Run Text="{Binding SpeedTestPingMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="Download" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}"><Run Text="{Binding SpeedTestDownloadMbps, StringFormat='{}{0:F1}'}"/><Run Text=" Mbps" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="Upload" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource VioletBrush}"><Run Text="{Binding SpeedTestUploadMbps, StringFormat='{}{0:F1}'}"/><Run Text=" Mbps" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatTile}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="Jitter" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource WarningBrush}"><Run Text="{Binding SpeedTestJitterMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Text="{Binding SpeedTestError}"
                     Visibility="{Binding SpeedTestError, Converter={StaticResource StringToVisConverter}}"
                     Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

          <TextBlock Text="{DynamicResource Network.History}" Style="{StaticResource SectionLabelStyle}"/>
          <DataGrid ItemsSource="{Binding SpeedTestHistory}" IsReadOnly="True" MaxHeight="160" Background="Transparent" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Network.Time}" Binding="{Binding Time}" Width="90" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Ping (ms)" Binding="{Binding PingMs, StringFormat='{}{0:F1}'}" Width="110" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Download (Mbps)" Binding="{Binding DownloadMbps, StringFormat='{}{0:F2}'}" Width="150" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Upload (Mbps)" Binding="{Binding UploadMbps, StringFormat='{}{0:F2}'}" Width="140" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Jitter (ms)" Binding="{Binding JitterMs, StringFormat='{}{0:F1}'}" Width="*" FontFamily="Consolas"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Diagnostic ping -->
      <Border Style="{StaticResource ModernCard}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="DIAGNOSTIC PING" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="{DynamicResource Network.TestAllServers}" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding PingAllCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
              <Button Content="{DynamicResource Network.Repair}" Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding RepairNetworkCommand}" Margin="8,0,0,0"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatTile}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Network.AveragePing}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"><Run Text="{Binding PingAverageMs, StringFormat='{}{0:F1}'}"/><Run Text=" ms" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatTile}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Network.Minimum}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}"><Run Text="{Binding PingMinMs}"/><Run Text=" ms" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatTile}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Network.Maximum}" Style="{StaticResource SectionLabelStyle}" Margin="0"/>
                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource WarningBrush}"><Run Text="{Binding PingMaxMs}"/><Run Text=" ms" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/></TextBlock>
              </StackPanel>
            </Border>
          </Grid>

          <DataGrid ItemsSource="{Binding PingResults}" IsReadOnly="True" MaxHeight="200" Background="Transparent" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Network.Server}" Binding="{Binding Host}" Width="*"/>
              <DataGridTemplateColumn Header="{DynamicResource Common.Status}" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Success, Converter={StaticResource BoolToOkErrConverter}}" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Success}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Success}" Value="False"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{DynamicResource Network.Latency}" Binding="{Binding Ms}" Width="120" FontFamily="Consolas"/>
              <DataGridTextColumn Header="{DynamicResource Common.Error}" Binding="{Binding Error}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Journal réparation -->
      <Border Style="{StaticResource ModernCard}" Visibility="{Binding RepairLog, Converter={StaticResource StringToVisConverter}}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Network.RepairLog}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{Binding RepairLog}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
