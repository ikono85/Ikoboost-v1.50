<Window x:Class="IkoboostWpf.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ikoboost"
        Width="420"
        Height="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

  <Window.Resources>
    <SolidColorBrush x:Key="LoadingBackgroundBrush" Color="#05070B"/>
    <SolidColorBrush x:Key="LoadingSurfaceBrush" Color="#0B1118"/>
    <SolidColorBrush x:Key="LoadingBorderBrush" Color="#203040"/>
    <SolidColorBrush x:Key="LoadingAccentBrush" Color="#00E5FF"/>
    <SolidColorBrush x:Key="LoadingAccentDimBrush" Color="#0097A7"/>
    <SolidColorBrush x:Key="LoadingTextSecondaryBrush" Color="#8EA3B5"/>

    <Storyboard x:Key="LoadingStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="RingRotate"
                       Storyboard.TargetProperty="Angle"
                       From="0" To="360"
                       Duration="0:0:1.5"/>
      <DoubleAnimation Storyboard.TargetName="ProgressScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="0" To="1"
                       Duration="0:0:2.4"/>
      <DoubleAnimation Storyboard.TargetName="ProgressGlow"
                       Storyboard.TargetProperty="Opacity"
                       From="0.45" To="1"
                       AutoReverse="True"
                       Duration="0:0:0.8"/>
      <DoubleAnimation Storyboard.TargetName="ScannerMove"
                       Storyboard.TargetProperty="Y"
                       From="-2" To="58"
                       Duration="0:0:1.8"/>
      <DoubleAnimation Storyboard.TargetName="DotOne"
                       Storyboard.TargetProperty="Opacity"
                       From="0.2" To="1"
                       AutoReverse="True"
                       Duration="0:0:0.6"/>
      <DoubleAnimation Storyboard.TargetName="DotTwo"
                       Storyboard.TargetProperty="Opacity"
                       From="0.2" To="1"
                       AutoReverse="True"
                       BeginTime="0:0:0.2"
                       Duration="0:0:0.6"/>
      <DoubleAnimation Storyboard.TargetName="DotThree"
                       Storyboard.TargetProperty="Opacity"
                       From="0.2" To="1"
                       AutoReverse="True"
                       BeginTime="0:0:0.4"
                       Duration="0:0:0.6"/>
    </Storyboard>
  </Window.Resources>

  <Border Background="{StaticResource LoadingBackgroundBrush}"
          BorderBrush="{StaticResource LoadingBorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
        <Grid Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,12">
          <Ellipse Stroke="{StaticResource LoadingBorderBrush}" StrokeThickness="2"/>
          <Path Stroke="{StaticResource LoadingAccentBrush}"
                StrokeThickness="2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Data="M34,1 A33,33 0 0 1 67,34"
                RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <RotateTransform x:Name="RingRotate"/>
            </Path.RenderTransform>
          </Path>
          <TextBlock Text="⚡"
                     Foreground="{StaticResource LoadingAccentBrush}"
                     FontSize="30"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="⚡ IKOBOOST"
                   Foreground="{StaticResource LoadingAccentBrush}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="SYSTEM MONITOR"
                   Foreground="{StaticResource LoadingTextSecondaryBrush}"
                   FontSize="10"
                   Margin="0,5,0,16"
                   HorizontalAlignment="Center"/>

        <Border Width="170"
                Height="62"
                BorderBrush="{StaticResource LoadingBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="9"
                Margin="0,0,0,14"
                ClipToBounds="True">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <Border Height="4" Background="{StaticResource LoadingBorderBrush}" CornerRadius="2" Margin="0,0,0,8"/>
              <Border Height="4" Width="112" HorizontalAlignment="Left" Background="{StaticResource LoadingBorderBrush}" CornerRadius="2" Margin="0,0,0,8"/>
              <Border Height="4" Width="138" HorizontalAlignment="Left" Background="{StaticResource LoadingBorderBrush}" CornerRadius="2"/>
            </StackPanel>
            <Border Height="2"
                    VerticalAlignment="Top"
                    Background="{StaticResource LoadingAccentDimBrush}"
                    Opacity="0.9">
              <Border.RenderTransform>
                <TranslateTransform x:Name="ScannerMove"/>
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Border>

        <Border Width="170"
                Height="3"
                Background="{StaticResource LoadingBorderBrush}"
                CornerRadius="2"
                ClipToBounds="True">
          <Border x:Name="ProgressGlow"
                  Background="{StaticResource LoadingAccentDimBrush}"
                  CornerRadius="2"
                  RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
            </Border.RenderTransform>
          </Border>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
          <Ellipse x:Name="DotOne" Width="7" Height="7" Fill="{StaticResource LoadingAccentDimBrush}" Opacity="0.2" Margin="0,0,7,0"/>
          <Ellipse x:Name="DotTwo" Width="7" Height="7" Fill="{StaticResource LoadingAccentDimBrush}" Opacity="0.2" Margin="0,0,7,0"/>
          <Ellipse x:Name="DotThree" Width="7" Height="7" Fill="{StaticResource LoadingAccentDimBrush}" Opacity="0.2"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,0,0,22" HorizontalAlignment="Center">
        <TextBlock Text="{DynamicResource Loading.Analysis}"
                   Foreground="{StaticResource LoadingTextSecondaryBrush}"
                   FontSize="10"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource Loading.Loading}"
                   Foreground="{StaticResource LoadingAccentBrush}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
