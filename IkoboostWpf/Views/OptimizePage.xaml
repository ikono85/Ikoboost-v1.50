<Page x:Class="IkoboostWpf.Views.OptimizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}"
      Title="{DynamicResource Nav.Optimize}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
<TextBlock Text="{DynamicResource Optimize.Title}" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

      <!-- 1. One-click maintenance -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.OneClick}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{DynamicResource Optimize.OneClickDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
          <Button Content="{DynamicResource Optimize.RunFullMaintenance}" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding OneClickMaintenanceCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 2. Nettoyage système -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.SystemCleanup}" Style="{StaticResource SectionLabelStyle}"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Optimize.CleanTemp}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CleanupCommand}" HorizontalAlignment="Left"/>
            <Button Content="Nettoyage avancé des disques" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CleanDiskCommand}" HorizontalAlignment="Left" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 3. Cleaner RAM -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="{DynamicResource Optimize.RamCleaner}" Style="{StaticResource SectionLabelStyle}"/>
              <TextBlock Text="{DynamicResource Optimize.RamDescription}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{DynamicResource Optimize.CleanRam}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CleanRamCommand}"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Optimize.Before}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding RamBeforeCleanupMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Optimize.After}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Style="{StaticResource MetricValueStyle}">
                  <Run Text="{Binding RamAfterCleanupMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Optimize.Freed}" Style="{StaticResource SectionLabelStyle}"/>
                <TextBlock Foreground="{DynamicResource WarningBrush}" FontSize="28" FontWeight="Light">
                  <Run Text="{Binding RamFreedMb, StringFormat='{}{0:N0}'}"/><Run Text=" Mo"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 4. Restauration -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.RestorePoint}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{DynamicResource Optimize.RestoreDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
          <Button Content="{DynamicResource Optimize.CreateRestorePoint}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding CreateRestorePointCommand}"
                  HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 5. Réparation système [NOUVEAU] -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Réparation système" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="Analyse et répare les fichiers système corrompus (SFC + DISM). Peut prendre plusieurs minutes."
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
          <Button Content="Réparer le registre" Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding RepairSystemCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 6. Profil alimentation -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.PowerPlan}" Style="{StaticResource SectionLabelStyle}"/>
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding PowerPlans.Keys}"
                      SelectedItem="{Binding SelectedPowerPlan}" Width="180"/>
            <Button Content="{DynamicResource Common.Apply}" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SetPowerPlanCommand}" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 7. Pilotes (Drivers) [NOUVEAU] -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Pilotes (Drivers)" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="Affiche les pilotes installés et lance une recherche de mises à jour via Windows Update."
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Lister les pilotes" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding LoadDriversCommand}"/>
            <Button Content="Chercher des mises à jour" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ScanDriverUpdatesCommand}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding DriverScanStatus}" Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,6,0,6"/>
          <DataGrid ItemsSource="{Binding InstalledDrivers}"
                    MaxHeight="240"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserResizeRows="False"
                    CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Appareil"   Binding="{Binding DeviceName}"   Width="*"/>
              <DataGridTextColumn Header="Fabricant"  Binding="{Binding ProviderName}" Width="160"/>
              <DataGridTextColumn Header="Version"    Binding="{Binding DriverVersion}" Width="120"/>
              <DataGridTextColumn Header="Date"       Binding="{Binding DriverDate}"   Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- 8. Registre -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.Registry}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{DynamicResource Optimize.RegistryDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{DynamicResource Optimize.RecommendedSelection}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SelectRecommendedRegistryOptimizationsCommand}"/>
            <Button Content="{DynamicResource Optimize.ClearAll}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ClearRegistryOptimizationSelectionCommand}"
                    Margin="8,0,0,0"/>
            <Button Content="{DynamicResource Optimize.ApplySelection}"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding ApplySelectedRegistryOptimizationsCommand}"
                    Margin="8,0,0,0"/>
          </StackPanel>

          <DataGrid ItemsSource="{Binding RegistryOptimizations}"
                    MaxHeight="260"
                    HeadersVisibility="Column"
                    CanUserResizeRows="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header=""
                                      Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="42"/>
              <DataGridTextColumn Header="{DynamicResource Optimize.Registry}"
                                  Binding="{Binding DisplayName}"
                                  Width="190"
                                  IsReadOnly="True"/>
              <DataGridTextColumn Header="{DynamicResource Common.Action}"
                                  Binding="{Binding Action}"
                                  Width="120"
                                  IsReadOnly="True"/>
              <DataGridTextColumn Header="{DynamicResource Common.Value}"
                                  Binding="{Binding ValueName}"
                                  Width="170"
                                  IsReadOnly="True"/>
              <DataGridTextColumn Header="{DynamicResource Common.Description}"
                                  Binding="{Binding Description}"
                                  Width="*"
                                  IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- 9. Bloatwares -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.Bloatware}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{DynamicResource Optimize.BloatwareDescription}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{DynamicResource Optimize.RecommendedSelection}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SelectRecommendedBloatwareCommand}"/>
            <Button Content="{DynamicResource Optimize.ClearAll}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ClearBloatwareSelectionCommand}"
                    Margin="8,0,0,0"/>
            <Button Content="{DynamicResource Optimize.UninstallSelection}"
                    Style="{StaticResource DangerButtonStyle}"
                    Command="{Binding UninstallSelectedBloatwareCommand}"
                    Margin="8,0,0,0"/>
          </StackPanel>

          <DataGrid ItemsSource="{Binding BloatwareApps}"
                    MaxHeight="260"
                    HeadersVisibility="Column"
                    CanUserResizeRows="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header=""
                                      Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="42"/>
              <DataGridTextColumn Header="{DynamicResource Nav.Applications}"
                                  Binding="{Binding DisplayName}"
                                  Width="180"
                                  IsReadOnly="True"/>
              <DataGridTextColumn Header="{DynamicResource Optimize.Package}"
                                  Binding="{Binding PackageName}"
                                  Width="240"
                                  IsReadOnly="True"/>
              <DataGridTextColumn Header="{DynamicResource Common.Description}"
                                  Binding="{Binding Description}"
                                  Width="*"
                                  IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- 10. Doublons de fichiers [NOUVEAU] -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Doublons de fichiers" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="Scanne un dossier pour trouver les fichiers identiques et libérer de l'espace."
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding DuplicateScanPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding ScanDuplicatesCommand}" Margin="8,0,0,0"/>
          </Grid>
          <TextBlock Text="{Binding DuplicateScanStatus}" Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="0,0,0,6"/>
          <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Header="{Binding Header}" Margin="0,2,0,2">
                  <ItemsControl ItemsSource="{Binding Files}" Margin="16,4,0,4">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                          <CheckBox IsChecked="{Binding IsSelectedForDelete, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Supprimer les sélectionnés" Style="{StaticResource DangerButtonStyle}"
                  Command="{Binding DeleteSelectedDuplicatesCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- 11. Log -->
      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Optimize.Log}" Style="{StaticResource SectionLabelStyle}"/>
          <TextBlock Text="{Binding Log}" Foreground="{DynamicResource TextPrimaryBrush}"
                     FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="80"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
