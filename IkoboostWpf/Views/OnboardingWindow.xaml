<Window x:Class="IkoboostWpf.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ikoboost"
        Width="760"
        Height="680"
        MinWidth="380"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="OnboardingWindow_Loaded"
        Style="{StaticResource WindowStyle}">

  <Window.Resources>
<Style x:Key="OnboardingChoiceButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="20">
        <Border x:Name="Card"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}"
                Padding="24">
          <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
          </Border.Effect>

          <StackPanel>
<UniformGrid Columns="4" Margin="0,0,0,22">
              <Border x:Name="ProgressOne" Height="5" CornerRadius="3" Margin="0,0,6,0"/>
              <Border x:Name="ProgressTwo" Height="5" CornerRadius="3" Margin="6,0"/>
              <Border x:Name="ProgressThree" Height="5" CornerRadius="3" Margin="6,0"/>
              <Border x:Name="ProgressFour" Height="5" CornerRadius="3" Margin="6,0,0,0"/>
            </UniformGrid>

            <TextBlock x:Name="EyebrowText"
                       Foreground="{DynamicResource AccentBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="TitleText"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="28"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       LineHeight="20"
                       TextWrapping="Wrap"
                       Margin="0,8,0,22"/>

            <Grid x:Name="StepHost">
              <StackPanel x:Name="LanguageStep">
                <UniformGrid x:Name="LanguageOptionsGrid" Columns="3" Margin="0,0,0,22"/>
                <Button x:Name="ContinueLanguageButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Click="ContinueLanguageButton_Click"/>
              </StackPanel>

              <StackPanel x:Name="DiscoveryStep" Visibility="Collapsed">
                <UniformGrid x:Name="DiscoveryOptionsGrid"
                             Columns="2"
                             Margin="0,0,0,22"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BackDiscoveryButton"
                          Grid.Column="0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Click="BackButton_Click"
                          Margin="0,0,8,0"/>
                  <Button x:Name="SkipDiscoveryButton"
                          Grid.Column="2"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Click="SkipDiscoveryButton_Click"
                          Margin="8,0,8,0"/>
                  <Button x:Name="ContinueDiscoveryButton"
                          Grid.Column="3"
                          Style="{StaticResource PrimaryButtonStyle}"
                          IsEnabled="False"
                          Click="ContinueDiscoveryButton_Click"/>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="ThemeStep" Visibility="Collapsed">
                <UniformGrid x:Name="ThemeOptionsGrid"
                             Columns="2"
                             Margin="0,0,0,22"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BackThemeButton"
                          Grid.Column="0"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Click="BackButton_Click"/>
                  <Button x:Name="ContinueThemeButton"
                          Grid.Column="2"
                          Style="{StaticResource PrimaryButtonStyle}"
                          IsEnabled="False"
                          Click="ContinueThemeButton_Click"/>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="ConfirmStep" Visibility="Collapsed">
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,20">
                  <TextBlock Text="✓"
                             Foreground="{DynamicResource BackgroundBrush}"
                             FontSize="42"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>

                <Border Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,22">
                  <StackPanel>
                    <TextBlock x:Name="SummaryTitleText"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="SummaryLanguageText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2"/>
                    <TextBlock x:Name="SummarySourceText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2"/>
                    <TextBlock x:Name="SummaryThemeText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2"/>
                  </StackPanel>
                </Border>

                <Button x:Name="EnterAppButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Click="EnterAppButton_Click"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
